{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quanly-giaoduc-fma-namhoa",
  "main": "./worker.js",
  "compatibility_date": "2026-08-07",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
